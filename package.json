{
  "name": "anamorph-workspace",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/lab && tsc --noEmit -p registry",
    "lint": "oxlint . --deny-warnings",
    "build": "npm run build -w anamorph",
    "gate:idle-zero": "node instruments/idle-zero/run.mjs",
    "dev": "npm run dev -w @anamorph/lab",
    "gate:sharpness": "node instruments/sharpness/run.mjs"
  },
  "devDependencies": {
    "@react-three/fiber": "^9.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.3",
    "happy-dom": "^20.11.1",
    "oxlint": "^1.77.0",
    "puppeteer-core": "^25.4.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
