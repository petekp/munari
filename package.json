{
  "name": "munari-workspace",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/lab && tsc --noEmit -p registry && tsc --noEmit -p tools",
    "lint": "oxlint . --deny-warnings",
    "build": "npm run build -w @petepetrash/munari",
    "check:origin-trial": "node apps/lab/tools/runLab.mjs --check-origin-trial",
    "gate:fisheye-pointer": "node instruments/fisheye-pointer/run.mjs",
    "gate:slider-drag": "node instruments/slider-drag/run.mjs",
    "gate:frame-surface": "node instruments/frame-surface/run.mjs",
    "gate:genie-duplicate": "node instruments/genie-drain/no-duplicate-drag.mjs",
    "gate:genie-film": "node instruments/genie-drain/film-window.mjs",
    "gate:genie-film-context": "node instruments/genie-drain/film-window-context.mjs",
    "probe:genie-film-soak": "node instruments/genie-drain/film-window-soak.mjs",
    "gate:genie-film-reorder": "node instruments/genie-drain/film-anchor-reorder.mjs",
    "gate:genie-shadow": "node instruments/genie-drain/shadow-travels.mjs",
    "gate:idle-zero": "node instruments/idle-zero/run.mjs",
    "gate:shaders": "node instruments/shader-compile/run.mjs",
    "gate:dom-surface-demand": "node instruments/dom-surface-demand/run.mjs",
    "gate:degraded": "node instruments/degraded/run.mjs",
    "gate:lab-interactions": "node instruments/lab-interactions/run.mjs",
    "gate:lifting-pointer": "node instruments/lifting-pointer/run.mjs",
    "gate:chrome-over-canvas": "node instruments/chrome-over-canvas/run.mjs",
    "gate:knobs-resize": "node instruments/knobs-resize/run.mjs",
    "gate:refraction-arriving": "node instruments/refraction-arriving/run.mjs",
    "gate:gallery-pointer": "node instruments/gallery-pointer/run.mjs",
    "dev": "npm run dev -w @munari/lab",
    "lab": "node apps/lab/tools/runLab.mjs",
    "deploy:demo": "npm run build -w @munari/lab && VERCEL_ORG_ID=team_d8NmNbma8pPIVCBkDXUnfpMa VERCEL_PROJECT_ID=prj_pe759NtaVMScHyupOSFSJ41NQiz7 vercel deploy --prod --yes --cwd apps/lab/dist"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.78.0",
    "@react-three/fiber": "^9.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.3",
    "happy-dom": "^20.11.1",
    "oxlint": "^1.78.0",
    "puppeteer-core": "^25.4.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
