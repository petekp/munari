{
  // Typechecks the TypeScript under tools/ (the anti-slop oxlint plugin).
  // The root program's `include` does not reach tools/, so this program
  // extends the root and inherits all of its compiler options. The plugin's
  // imports spell out the `.ts` extension, because oxlint loads these files
  // unbundled at the paths written in the imports. The root's
  // `allowImportingTsExtensions` is what lets tsc accept that spelling.
  "extends": "../tsconfig.json",
  "include": ["."]
}
