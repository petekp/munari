node_modules/
dist/
coverage/

# What the instruments PRINT is the record; what they dump is scratch.
# The scripts are committed infrastructure, their frame grabs are not —
# they only exist when DUMP=1 asks for a look at a failing frame.
instruments/**/out/
*.log
.DS_Store
.claude/
.circuit/

# TypeScript incremental build state
*.tsbuildinfo

# Review-agent working state: transcripts and their database. Local by
# nature and often huge, and `git add -A` would otherwise sweep them into
# a commit. Ignore them while active; remove them after every run is terminal.
.smithers/
smithers.db*
