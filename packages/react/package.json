{
  "name": "@petepetrash/munari",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "HTML, 3D, and Shaders, Unified. Retained HTML and interactive Three.js scenes for React.",
  "license": "MIT",
  "author": "Pete Petrash",
  "homepage": "https://github.com/petekp/munari#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/petekp/munari.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/petekp/munari/issues"
  },
  "keywords": [
    "webgl",
