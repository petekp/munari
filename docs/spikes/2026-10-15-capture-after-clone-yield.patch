new file mode 100644
--- /dev/null
+++ b/packages/react/src/snapdomCaptureTask.ts
@@ -0,0 +1,8 @@
+// Capture task — a browser task boundary between capture stages.
+// A Controls rAF callback interval, including promise microtasks, reached
+// 95.1 ms at 6× CPU slowdown (2026-10-15, decisions.md #62).
+// Callers own invalidation and publication.
+
+export async function yieldCaptureTask(): Promise<void> {
+  await (globalThis.scheduler?.yield?.() ?? new Promise<void>(resolve => setTimeout(resolve, 0)))
+}
