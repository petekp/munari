{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "vitest"],
  "jsPlugins": [
    { "name": "anti-slop", "specifier": "./tools/oxlint/anti-slop/index.ts" },
    { "name": "no-tautological-absence", "specifier": "./tools/oxlint/no-tautological-absence/index.mjs" }
  ],
  "categories": {
    "correctness": "warn"
  },
  "rules": {
    "eslint/complexity": ["warn", { "max": 20 }],
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-runtime-typeof": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error",
    "no-tautological-absence/no-tautological-absence": "error",
    "eslint/no-warning-comments": ["error", { "terms": ["TODO", "FIXME", "HACK"], "location": "anywhere" }],
    "eslint/no-unused-vars": ["error", { "args": "after-used", "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "ignoreRestSiblings": true }],
    "eslint/no-restricted-imports": ["error", { "patterns": [{ "group": ["**/tests/**", "**/__tests__/**/*", "**/*.test.*", "**/*.spec.*"], "message": "Do not import test files in source files" }] }],
    "typescript/no-explicit-any": "error",
    "vitest/expect-expect": "off",
    "vitest/no-conditional-expect": "off",
    "vitest/no-standalone-expect": "off",
    "vitest/require-mock-type-parameters": "off",
    "vitest/valid-expect": "off"
  },
  "overrides": [
    {
      "files": ["**/tests/**", "**/__tests__/**/*", "**/*.test.*", "**/*.spec.*"],
      "rules": {
        "eslint/no-restricted-imports": "off",
        "vitest/no-import-node-test": "error"
      }
    }
  ],
  "ignorePatterns": [
    "**/dist/**",
    "**/coverage/**",
    "**/node_modules/**",
    ".agent/**",
    ".agents/**",
    ".circuit/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "tools/oxlint/anti-slop/**",
    "tools/oxlint/no-tautological-absence/**"
  ]
}
